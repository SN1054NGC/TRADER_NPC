// ============================================================
// FILE: TraderRating.layout  (survival-rating badge, DeepSeek Harness style)
// Created as a CHILD overlay of the inventory / trader window - it never
// replaces a host layout.
//
// Vanilla conventions used here (see gui/layouts examples):
//   * corner anchoring: halign left_ref + valign bottom_ref with a NEGATIVE
//     vertical offset (position 0.015 -0.03) -> "1.5% from the left edge,
//     3% above the bottom edge". Vanilla HUD does the same, e.g.
//     day_z_hud.layout BadgesPanel { position 252 -0.00001; right_ref/bottom_ref }.
//   * the three rows are stacked with a native GridSpacerWidgetClass
//     (Columns 1 / Rows 3), the pattern used by option lists and camera_tools.
//   * the progress bar is a native ProgressBarWidgetClass
//     (day_z_hud.layout item_quantity_pb: style Quantity, vertical 0, flipped 0);
//     the script drives it with SimpleProgressBarWidget.SetCurrent().
//   * fonts/sizes follow vanilla: sdf_MetronLight24 @ 18 for labels,
//     sdf_MetronBold24 @ 24 for the highlighted "-N%".
//
// Widget names used by the scripts: RatingRoot, RatingValue, RatingInfo,
// RatingBar (SimpleProgressBarWidget).
// ============================================================
FrameWidgetClass RatingRoot {
 visible 1
 clipchildren 1
 ignorepointer 1
 position 0.015 -0.03
 size 0.21 0.10
 halign left_ref
 valign bottom_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 priority 90
 {
  ImageWidgetClass RatingBorder {
   visible 1
   ignorepointer 1
   color 0.228 0.228 0.302 1
   position 0 0
   size 1 1
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 1
   image0 "set:dayz_gui image:ColorableBar"
   mode blend
   "src alpha" 1
   "clamp mode" clamp
   "stretch mode" stretch_w_h
  }
  ImageWidgetClass RatingFill {
   visible 1
   ignorepointer 1
   color 0.071 0.071 0.102 0.96
   position 0.005 0.012
   size 0.990 0.976
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 2
   image0 "set:dayz_gui image:ColorableBar"
   mode blend
   "src alpha" 1
   "clamp mode" clamp
   "stretch mode" stretch_w_h
  }
  ImageWidgetClass RatingAccent {
   visible 1
   ignorepointer 1
   color 0.353 0.655 1 0.9
   position 0.005 0.012
   size 0.007 0.976
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 3
   image0 "set:dayz_gui image:ColorableBar"
   mode blend
   "src alpha" 1
   "clamp mode" clamp
   "stretch mode" stretch_w_h
  }
  // ---- 3 stacked rows: title+value / survived / progress bar ----------
  GridSpacerWidgetClass RatingRows {
   ignorepointer 1
   color 0 0 0 0
   position 0.060 0.11
   size 0.905 0.78
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 4
   "no focus" 1
   Padding 1
   Margin 0
   Columns 1
   Rows 3
   content_halign left
   {
    FrameWidgetClass RatingRowTop {
     ignorepointer 1
     position 0 0
     size 1 1
     halign left_ref
     valign top_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 1
     {
      TextWidgetClass RatingTitle {
       visible 1
       clipchildren 0
       ignorepointer 1
       position 0 0
       size 0.55 1
       halign left_ref
       valign top_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       priority 1
       style Normal
       text "#tm_rating_title"
       font "gui/fonts/sdf_MetronLight24"
       "text color" 0.580 0.588 0.667 1
       "exact text" 1
       "exact text size" 18
       "size to text h" 0
       "size to text v" 0
       "text halign" left
       "text valign" center
       wrap 0
      }
      TextWidgetClass RatingValue {
       visible 1
       clipchildren 0
       ignorepointer 1
       position 0.55 0
       size 0.45 1
       halign left_ref
       valign top_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       priority 2
       style Bold
       text "-0%"
       font "gui/fonts/sdf_MetronBold24"
       "text color" 0.451 0.902 0.627 1
       "exact text" 1
       "exact text size" 24
       "size to text h" 0
       "size to text v" 0
       "text halign" right
       "text valign" center
       wrap 0
      }
     }
    }
    FrameWidgetClass RatingRowMid {
     ignorepointer 1
     position 0 0
     size 1 1
     halign left_ref
     valign top_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 1
     {
      TextWidgetClass RatingInfo {
       visible 1
       clipchildren 0
       ignorepointer 1
       position 0 0
       size 1 1
       halign left_ref
       valign top_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       priority 1
       style Normal
       text ""
       font "gui/fonts/sdf_MetronLight24"
       "text color" 0.890 0.898 0.925 1
       "exact text" 1
       "exact text size" 18
       "size to text h" 0
       "size to text v" 0
       "text halign" left
       "text valign" center
       wrap 0
      }
     }
    }
    FrameWidgetClass RatingRowBar {
     ignorepointer 1
     position 0 0
     size 1 1
     halign left_ref
     valign top_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 1
     {
      ProgressBarWidgetClass RatingBar {
       visible 1
       ignorepointer 1
       color 1 1 1 1
       position 0 0
       size 1.0 0.42
       halign center_ref
       valign center_ref
       hexactpos 0
       vexactpos 0
       hexactsize 0
       vexactsize 0
       priority 1
       style Default
       "no focus" 1
       maximum 100
       Progress 0
       vertical 0
       flipped 0
      }
     }
    }
   }
  }
 }
}
