       vexactsize 0
       priority 1
       image0 "set:dayz_gui image:ColorableBar"
       mode blend
       "src alpha" 1
       "clamp mode" clamp
       "stretch mode" stretch_w_h
      }
      ImageWidgetClass CardFill {
