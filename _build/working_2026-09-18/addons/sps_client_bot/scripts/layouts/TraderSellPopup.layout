// ============================================================
// FILE: TraderSellPopup.layout  (compact item-sell window)
// Visual language: DeepSeek-Harness-like dark UI (flat cards, thin accent
// line, blue accent, muted gray text) - expressed with plain ImageWidget
// fills ("set:dayz_gui image:ColorableBar"), so no new art is required.
//
// PALETTE (DeepSeek Harness)
//   bg    #12121a  0.071 0.071 0.102
//   pan   #1c1c27  0.110 0.110 0.153
//   pan2  #262634  0.149 0.149 0.204
//   line  #3a3a4d  0.228 0.228 0.302
//   txt   #e3e5ec  0.890 0.898 0.925
//   mut   #9496aa  0.580 0.588 0.667
//   acc   #5aa7ff  0.353 0.655 1.000
//   ok    #73e6a0  0.451 0.902 0.627
//   red   #532029  0.325 0.125 0.161
//
// GEOMETRY RULES (fractions are relative to the PARENT widget):
//   * hexactpos/vexactpos/hexactsize/vexactsize = 0 -> fractions of parent.
//   * WindowWidget = 46% x 52% of the screen, centred by center_ref.
//   * Card border = 2-3 px: CardBorder (line) with CardFill (bg) inset over it.
//
// REQUIRED WIDGET NAMES (vanilla InspectMenuNew.SetItem writes into them and
// dereferences ItemFrameWidget with no null check):
//   InventoryInfoPanelWidget, ItemFrameWidget, ItemNameWidget,
//   ItemDamageWidget, ItemLiquidTypeWidget, ItemTemperatureWidget,
//   ItemWetnessWidget, ItemFoodStageWidget, ItemWeightWidget,
//   ItemQuantityWidget, ItemCleannessWidget, ItemDescWidget,
//   BackBtn1 (userID 2 = IDC_CANCEL)
// Sell area added by the mod:
//   SellRow, SellRowBg, SellPriceWidget, SellAmountWidget, SellSlider,
//   SellButton (userID 90012), SellButtonRed, NoPriceWidget
// ============================================================
FrameWidgetClass rootFrame {
 clipchildren 1
 ignorepointer 0
 color 1 1 1 1
 position 0 0
 size 1 1
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 priority 2
 {
  FrameWidgetClass WindowWidget {
   ignorepointer 0
   position 0 0
   size 0.46 0.52
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 1
   {
    FrameWidgetClass BackPanelWidget {
     visible 1
     clipchildren 1
     position 0 0
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 1
     style blank
     {
