// ============================================================
// FILE: TraderRating.layout  (survival-rating badge, v3 - vanilla look)
//  * PanelWidgetClass + style DayZDefaultPanel (the in-game panel style),
//    GridSpacerWidgetClass with style Empty for the 4 stacked rows,
//    ProgressBarWidgetClass with style Default (driven by SetCurrent from the script).
//  * icons: icon_favourite_on(20x20) - the rating star, right_mouse(38x38) - the
//    sell hint (right button), both from the dayz_gui image set.
//  * anchor fix: bottom_ref offset is measured INWARD, so the badge uses +0.03
//    (v2 used -0.03 and the badge hung 32 px below the screen edge).
// Widget names used by the scripts: RatingRoot, RatingValue, RatingInfo, RatingBar.
// ============================================================
FrameWidgetClass RatingRoot {
 visible 1
 clipchildren 1
 ignorepointer 1
 position 0.015 0.03
 size 0.215 0.105
 halign left_ref
 valign bottom_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 priority 90
 {
  PanelWidgetClass RatingPanel {
   visible 1
   ignorepointer 1
   color 0 0 0 0.85
   position 0 0
   size 1 1
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 1
   style DayZDefaultPanel
  }
  GridSpacerWidgetClass RatingRows {
   ignorepointer 1
   color 0 0 0 0
   position 0.055 0.09
   size 0.90 0.82
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 2
   style Empty
   "no focus" 1
   Padding 1
   Margin 0
   Columns 1
   Rows 4
   content_halign left
   {
   FrameWidgetClass RatingRowTop {
    ignorepointer 1
    position 0 0
    size 1 1
    halign left_ref
    valign top_ref
    hexactpos 0
    vexactpos 0
    hexactsize 0
    vexactsize 0
    priority 1
    {
    ImageWidgetClass RatingStar {
     visible 1
     ignorepointer 1
     color 1 1 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 1
     vexactsize 1
     fixaspect fixwidth
     mode blend
     src alpha 1
     clamp mode clamp
     filter 1
     image0 "set:dayz_gui image:icon_favourite_on"
     position 0 0
     size 18 18
     priority 2
    }
    TextWidgetClass RatingTitle {
     visible 1
     clipchildren 0
     ignorepointer 1
     position 24 0
     size 0.52 1
     halign left_ref
     valign top_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     priority 2
     style Normal
     text "#tm_rating_title"
     font "gui/fonts/sdf_MetronLight24"
     "text color" 0.580 0.588 0.667 1
     "exact text" 1
     "exact text size" 18
     "text halign" left
     "text valign" center
    }
    TextWidgetClass RatingValue {
     visible 1
     clipchildren 0
     ignorepointer 1
     position 0 0
     size 0.42 1
     valign top_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     halign right_ref
     priority 3
     style Bold
     text "-0%"
     font "gui/fonts/sdf_MetronBook24"
     "text color" 0.451 0.902 0.627 1
     "exact text" 1
     "exact text size" 24
     "bold text" 1
     "text halign" right
     "text valign" center
    }
    }
   }
   FrameWidgetClass RatingRowMid {
    ignorepointer 1
    position 0 0
    size 1 1
    halign left_ref
    valign top_ref
    hexactpos 0
    vexactpos 0
    hexactsize 0
    vexactsize 0
    priority 1
    {
    TextWidgetClass RatingInfo {
     visible 1
     clipchildren 0
     ignorepointer 1
     position 0 0
     size 1 1
     halign left_ref
     valign top_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 2
     style Normal
     text ""
     font "gui/fonts/sdf_MetronLight24"
     "text color" 0.890 0.898 0.925 1
     "exact text" 1
     "exact text size" 18
     "text halign" left
     "text valign" center
    }
    }
   }
   FrameWidgetClass RatingRowBar {
    ignorepointer 1
    position 0 0
    size 1 1
    halign left_ref
    valign top_ref
    hexactpos 0
    vexactpos 0
    hexactsize 0
    vexactsize 0
    priority 1
    {
    ProgressBarWidgetClass RatingBar {
     visible 1
     ignorepointer 1
     color 1 1 1 1
     position 0 0
     size 1 0.45
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     halign center_ref
     valign center_ref
     priority 2
     style Default
     "no focus" 1
     maximum 100
     Progress 0
     vertical 0
     flipped 0
    }
    }
   }
   FrameWidgetClass RatingRowHint {
    ignorepointer 1
    position 0 0
    size 1 1
    halign left_ref
    valign top_ref
    hexactpos 0
    vexactpos 0
    hexactsize 0
    vexactsize 0
    priority 1
    {
    ImageWidgetClass RatingHintIcon {
     visible 1
     ignorepointer 1
     color 1 1 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 1
     vexactsize 1
     fixaspect fixwidth
     mode blend
     src alpha 1
     clamp mode clamp
     filter 1
     image0 "set:dayz_gui image:right_mouse"
     position 0 0
     size 18 18
     priority 2
    }
    TextWidgetClass RatingHint {
     visible 1
     clipchildren 0
     ignorepointer 1
     position 24 0
     size 0.92 1
     halign left_ref
     valign top_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     priority 2
     style Normal
     text "#tm_sell_hint"
     font "gui/fonts/sdf_MetronLight24"
     "text color" 0.580 0.588 0.667 1
     "exact text" 1
     "exact text size" 18
     "text halign" left
     "text valign" center
    }
    }
   }
   }
  }
 }
}
