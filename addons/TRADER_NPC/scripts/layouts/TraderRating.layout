// ============================================================
// TraderRating.layout — компактный значок рейтинга выживания.
// v4: перенесён вниз по центру, под цифровые блоки быстрого доступа
// (хотбар заканчивается на y=1026 при 1080), строка "ПКМ — продать"
// убрана. Стиль и шрифты — ванильные.
// Имена виджетов для скриптов: RatingRoot, RatingValue, RatingInfo, RatingBar.
// ============================================================
FrameWidgetClass RatingRoot {
 visible 1
 clipchildren 1
 ignorepointer 1
 position 0.012 0.008
 size 0.30 0.038
 halign right_ref
 valign bottom_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 priority 90
 {
  PanelWidgetClass RatingPanel {
   visible 1
   ignorepointer 1
   color 0 0 0 0.72
   position 0 0
   size 1 1
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 1
   style DayZDefaultPanel
  }
  TextWidgetClass RatingValue {
   visible 1
   clipchildren 0
   ignorepointer 1
   position 0.02 0.05
   size 0.17 0.90
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 2
   style Bold
   text ""
   font "gui/fonts/sdf_MetronBook24"
   "text color" 0.451 0.902 0.627 1
   "exact text" 1
   "exact text size" 20
   "bold text" 1
   "text halign" left
   "text valign" center
  }
  TextWidgetClass RatingInfo {
   visible 1
   clipchildren 0
   ignorepointer 1
   position 0.20 0.05
   size 0.56 0.90
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 2
   style Normal
   text ""
   font "gui/fonts/sdf_MetronLight24"
   "text color" 0.890 0.898 0.925 1
   "exact text" 1
   "exact text size" 16
   "bold text" 0
   "text halign" left
   "text valign" center
  }
  CheckBoxWidgetClass RatingHudCheck {
   visible 1
   ignorepointer 0
   position 0.76 0.04
   size 0.11 0.92
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 4
   style Default
   font "gui/fonts/Metron22"
   text "#tm_rating_hud"
  }
  ButtonWidgetClass RatingToggle {
   visible 1
   ignorepointer 0
   position 0.88 0.04
   size 0.075 0.92
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 4
   style MenuDefault
   text ""
   {
    ImageWidgetClass RatingIconCollapse {
     visible 1
     ignorepointer 1
     color 1 1 1 1
     fixaspect fixwidth
     mode blend
     "src alpha" 1
     "clamp mode" clamp
     filter 1
     image0 "set:dayz_gui image:icon_collapse"
     position 0 0
     size 16 16
     halign center_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     priority 2
    }
    ImageWidgetClass RatingIconExpand {
     visible 0
     ignorepointer 1
     color 1 1 1 1
     fixaspect fixwidth
     mode blend
     "src alpha" 1
     "clamp mode" clamp
     filter 1
     image0 "set:dayz_gui image:icon_expand"
     position 0 0
     size 16 16
     halign center_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     priority 2
    }
   }
  }
  SimpleProgressBarWidgetClass RatingBar {
   visible 1
   ignorepointer 1
   color 0.451 0.902 0.627 1
   position 0.02 0.86
   size 0.96 0.10
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 3
   style Default
   current 0
  }
 }
}
