// ============================================================
// TraderRating.layout — компактный значок рейтинга выживания.
// v4: перенесён вниз по центру, под цифровые блоки быстрого доступа
// (хотбар заканчивается на y=1026 при 1080), строка "ПКМ — продать"
// убрана. Стиль и шрифты — ванильные.
// Имена виджетов для скриптов: RatingRoot, RatingValue, RatingInfo, RatingBar.
// ============================================================
FrameWidgetClass RatingRoot {
 visible 1
 clipchildren 1
 ignorepointer 1
 position 0 0.004
 size 0.30 0.038
 halign center_ref
 valign bottom_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 priority 90
 {
  PanelWidgetClass RatingPanel {
   visible 1
   ignorepointer 1
   color 0 0 0 0.72
   position 0 0
   size 1 1
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 1
   style DayZDefaultPanel
  }
  TextWidgetClass RatingValue {
   visible 1
   clipchildren 0
   ignorepointer 1
   position 0.02 0.05
   size 0.17 0.90
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 2
   style Bold
   text ""
   font "gui/fonts/sdf_MetronBook24"
   "text color" 0.451 0.902 0.627 1
   "exact text" 1
   "exact text size" 20
   "bold text" 1
   "text halign" left
   "text valign" center
  }
  TextWidgetClass RatingInfo {
   visible 1
   clipchildren 0
   ignorepointer 1
   position 0.20 0.05
   size 0.78 0.90
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 2
   style Normal
   text ""
   font "gui/fonts/sdf_MetronLight24"
   "text color" 0.890 0.898 0.925 1
   "exact text" 1
   "exact text size" 16
   "bold text" 0
   "text halign" left
   "text valign" center
  }
  SimpleProgressBarWidgetClass RatingBar {
   visible 1
   ignorepointer 1
   color 0.451 0.902 0.627 1
   position 0.02 0.86
   size 0.96 0.10
   halign left_ref
   valign top_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 3
   style Default
   current 0
  }
 }
}
