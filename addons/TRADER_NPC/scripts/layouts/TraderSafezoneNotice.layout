// ============================================================
// TraderSafezoneNotice.layout — индикатор входа/выхода из сейф-зоны.
// Расположен по центру сверху в свободной зоне HUD (замер: подсказки
// действий занимают 412..762, справа оружие с 1430), поэтому 660..1260.
// Стиль и шрифты — ванильные, как в остальных уведомлениях.
// ============================================================
FrameWidgetClass Container {
 ignorepointer 1
 position 660 60
 size 600 300
 halign left_ref
 valign top_ref
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 {
  WrapSpacerWidgetClass Wrapper {
   ignorepointer 1
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   "Size To Content V" 1
   content_halign center
  }
 }
}
